#!/usr/bin/env python3
"""vale-fix-all — apply the first suggestion of every fixable Vale alert.

Edits files in place, re-running Vale until nothing fixable changes.
Alerts with no suggestion (first person, passive voice, …) are left alone.

Usage: ./vale-fix-all [--config .vale.ini] file.md ...
"""
import argparse
import json
import re
import subprocess
from pathlib import Path

HERE = Path(__file__).resolve().parent


def vale(*args):
    return subprocess.run(["vale", *args], capture_output=True, text=True, cwd=HERE).stdout


def fix_file(path, config, max_rounds=5):
    changes = []
    for _ in range(max_rounds):
        alerts = json.loads(vale("--config", config, "--output=JSON", str(path.resolve())) or "{}")
        alerts = next(iter(alerts.values()), [])
        lines = path.read_text(encoding="utf-8").split("\n")
        changed = False
        # Right-to-left so earlier spans on the same line stay valid.
        for a in sorted(alerts, key=lambda a: (a["Line"], a["Span"][0]), reverse=True):
            sugg = json.loads(vale("fix", json.dumps(a)))["suggestions"]
            if not sugg:
                continue
            n = a["Line"] - 1
            line = lines[n]
            match, rep = a["Match"].rstrip("\n"), sugg[0].rstrip("\n")
            # Vale reports curly apostrophes as straight ones.
            norm, nmatch = line.replace("’", "'"), match.replace("’", "'")
            i = a["Span"][0] - 1
            if norm[i:i + len(nmatch)] != nmatch:
                i = norm.find(nmatch)
                if i < 0:
                    continue
            if rep and line[i:i + 1].isupper() and (i == 0 or not line[:i].strip()):
                rep = rep[0].upper() + rep[1:]
            new = line[:i] + rep + line[i + len(match):]
            new = re.sub(r"(?<=\S)  +(?=\S)", " ", new).rstrip() if rep == "" else new
            if new != line:
                lines[n] = new
                changes.append((a["Line"], a["Check"], match, rep))
                changed = True
        path.write_text("\n".join(lines), encoding="utf-8")
        if not changed:
            break
    return changes


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("files", nargs="+", type=Path)
    p.add_argument("--config", default=str(HERE / ".vale.ini"))
    p.add_argument("-q", "--quiet", action="store_true")
    args = p.parse_args()
    for f in args.files:
        changes = fix_file(f, args.config)
        if not args.quiet:
            print(f"{f.name}: {len(changes)} fix{'es' * (len(changes) != 1)}")
            for line, check, old, new in sorted(changes):
                print(f"  {line:>3} {check}: {old!r} → {new!r}")


if __name__ == "__main__":
    main()
